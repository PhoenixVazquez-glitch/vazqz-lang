stainless.yml
upload_spec: true

environments:
  production: https://api.vazqz.com
  sandbox: https://sandbox.api.vazqz.com

targets:
  typescript:
    publish:
      npm: true
  python:
    publish:
      pypi: true
  ruby:
    publish:
      rubygems: true
  bash:
    publish:
      npm: false

client:
  name: vazqz
  package_name: vazqz-sdk
.github/workflows/stainless.yml
name: Stainless

on:
  push:
    branches: [main]
  pull_request:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Upload OpenAPI spec
        uses: stainless-api/upload-openapi-spec-action@v1
        with:
          stainless_api_key: ${{ secrets.STAINLESS_API_KEY }}
          org: ${{ secrets.STAINLESS_ORG }}
          project: ${{ secrets.STAINLESS_PROJECT }}
          oas_path: openapi.yaml
openapi.yaml
openapi: 3.1.0
info:
  title: VAZQZ API
  version: 0.9.1
  description: API spec for the VAZQZ SDK and CLI.
servers:
  - url: https://api.vazqz.com
  - url: https://sandbox.api.vazqz.com
paths:
  /v1/health:
    get:
      summary: Health check
      operationId: getHealth
      responses:
        "200":
          description: OK
  /v1/tasks:
    post:
      summary: Create task
      operationId: createTask
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
              required: [name]
      responses:
        "201":
          description: Created
components:
  schemas:
    Task:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
README.md
# VAZQZ SDK

VAZQZ is a multi-language SDK and CLI platform for building, packaging, and running developer tools.

## Features
- TypeScript, Python, Ruby, and Bash-friendly workflows
- CLI-first and SDK-friendly design
- OpenAPI-driven generation
- GitHub + Stainless ready
- Docs-friendly structure for GitBook or Stainless Docs

## Quickstart
1. Install the SDK.
2. Configure your API key.
3. Run the CLI or import the SDK in your language of choice.

## Docs
- [Quickstart](docs/quickstart.md)
- [Installation](docs/installation.md)
- [CLI](docs/cli.md)
- [Python](docs/python.md)
- [Ruby](docs/ruby.md)
- [TypeScript](docs/typescript.md)
- [Bash](docs/bash.md)
- [Troubleshooting](docs/troubleshooting.md)
- [Changelog](docs/changelog.md)

## Pricing
See [pricing.md](pricing.md) for Free, Pro, Team, and Enterprise plans.

## License
See [LICENSE](LICENSE).
pricing.md
# Pricing

## Free
- Public docs
- Community support
- Basic CLI usage

## Pro
- Advanced SDK features
- Higher limits
- Priority support

## Team
- Collaboration tools
- Shared workspaces
- Team permissions

## Enterprise
- SSO
- SLA
- Dedicated support
- Custom integrations

## Usage overages
Charge for:
- Hosted builds
- API requests
- Private package publishing
- Advanced automation
CONTRIBUTING.md
# Contributing

Thanks for helping improve VAZQZ.

## Before you start
- Open an issue for major changes.
- Keep PRs small and focused.
- Include tests when possible.

## Workflow
1. Fork the repo.
2. Create a branch.
3. Make changes.
4. Run tests.
5. Open a pull request.
